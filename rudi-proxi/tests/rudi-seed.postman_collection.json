		{
			"name": "Add x metadata",
			"item": [
				{
					"name": "Add x metadata",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"New metadata created\", () => {",
									"    pm.expect(pm.response.code).to.eql(200);",
									"    const responseJson = pm.response.json();",
									"    console.log(responseJson);",
									"    pm.expect(responseJson.contacts.length).to.eq(2);",
									"});"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"function randomPickInList(list) {",
									"    const randomNumber = _.random(0, list.length-1);",
									"    return list[randomNumber];",
									"}",
									"function randomPick(listName) {",
									"    return randomPickInList(pm.collectionVariables.get(listName));",
									"}",
									"",
									"pm.collectionVariables.set('randomTheme', randomPick('themes'));",
									"pm.collectionVariables.set('randomKeyword1', randomPick('keywords'));",
									"pm.collectionVariables.set('randomKeyword2', randomPick('keywords'));",
									"pm.collectionVariables.set('randomLicence', randomPick('licences'));",
									"",
									"const orgs = [pm.variables.get('orgId1'), pm.variables.get('orgId2')]",
									"pm.collectionVariables.set('randomOrg', randomPickInList(orgs));",
									"",
									"const contacts = [ pm.variables.get('contId1'), pm.variables.get('contId2'), pm.variables.get('contId3')]",
									"pm.collectionVariables.set('randomContact1', randomPickInList(contacts));",
									"pm.collectionVariables.set('randomContact2', randomPickInList(contacts));",
									"",
									"pm.collectionVariables.set('randomTitle', pm.variables.replaceIn('{{$randomCatchPhrase}}'));",
									"pm.collectionVariables.set('randomSynopsis', `${pm.variables.replaceIn('{{$randomProductAdjective}}')} ${pm.variables.replaceIn('{{$randomBs}}')}`);",
									"pm.collectionVariables.set('randomSummary', `${pm.variables.replaceIn('{{$randomPhrase}}')} ${pm.variables.replaceIn('{{$randomPhrase}}')} ${pm.variables.replaceIn('{{$randomLoremParagraph}}')}`);",
									"",
									""
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"global_id\": \"{{$randomUUID}}\",\n    \"resource_title\": \"{{randomTitle}}\",\n    \"synopsis\": [\n        {\n            \"lang\": \"fr\",\n            \"text\": \"{{randomSynopsis}}\"\n        }\n    ],\n    \"summary\": [\n        {\n            \"lang\": \"fr\",\n            \"text\": \"{{randomSummary}}\"\n        }\n    ],\n    \"theme\": \"{{randomTheme}}\",\n    \"keywords\": [\"{{randomKeyword1}}\", \"{{randomKeyword2}}\"],\n    \"geography\": {\n        \"bounding_box\": {\n            \"west_longitude\": -1.677803,\n            \"east_longitude\": -1.677803,\n            \"north_latitude\": 48.112834,\n            \"south_latitude\": 48.112834\n        }\n    },\n    \"temporal_spread\": {\n        \"start_date\": \"{{$randomDatePast}}\"\n    },\n    \"resource_languages\": [\n        \"fr\"\n    ],\n    \"producer\": {\n        \"organization_id\": \"{{randomOrg}}\"\n    },\n    \"contacts\": [\n        {\n            \"contact_id\": \"{{randomContact1}}\"\n        },\n        {\n            \"contact_id\": \"{{randomContact2}}\"\n        }\n    ],\n    \"metadata_info\": {\n        \"api_version\": \"{{apiVersion}}\",\n        \"metadata_provider\": {\n            \"organization_id\": \"{{orgId1}}\"\n        }\n    },\n    \"dataset_dates\": {\n        \"created\": \"{{$randomDateRecent}}\",\n        \"published\": \"{{now}}\"\n    },\n    \"storage_status\": \"online\",\n    \"access_condition\":{\n        \"licence\":{\n            \"licence_type\":\"STANDARD\",\n            \"licence_label\":\"licence_mit\"\n            \n        }\n    },\n    \"available_formats\": [\n        {\n            \"media_type\": \"FILE\",\n            \"media_id\": \"{{mediaId1}}\",\n            \"connector\": {\n                \"url\": \"https://app.swaggerhub.com/apis/OlivierMartineau/RUDI-PRODUCER/1.1.0\"\n            },\n            \"file_type\": \"application/json\",\n            \"file_size\": 59016,\n            \"checksum\": {\n                \"algo\": \"MD5\",\n                \"hash\": \"4c9ee0f14e835927a1bbafde0eb89fb3\"\n            }\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/{{apiUrl}}/{{data}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"{{apiUrl}}",
								"{{data}}"
							]
						}
					},
					"response": []
				}
			]
