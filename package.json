{
  "name": "rudi-prod-api",
  "version": "1.2.3",
  "private": false,
  "description": "API for RUDI producer node",
  "main": "./rudiServer.js",
  "type": "module",
  "scripts": {
    "prestart": "npm install",
    "start": "nodemon ./rudiServer.js",
    "extstart": "nodemon -e js,ini --exec \"npm run rudiapp\"",
    "rudiapp": "npm install && node rudiServer.js",
    "devstart": "nodemon ./rudiServer.js --conf=./0-ini/conf_custom.ini",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint \"**/*.js\""
  },
  "nodemonConfig": {
    "execMap": {
      "js": "export RUDI_API_GIT_REV=\"$(git rev-parse --short HEAD)\"; node "
    }
  },
  "keywords": [
    "api",
    "rudi",
    "rudi-producer",
    "metadata",
    "open-data"
  ],
  "author": "Olivier Martineau <community@rudi-univ-rennes1.fr>",
  "homepage": "https://app.swaggerhub.com/apis/OlivierMartineau/RUDI-PRODUCER",
  "license": "EUPL-1.2",
  "dependencies": {
    "@aqmo.org/rudi_logger": "^1.1.2",
    "axios": "^0.27.2",
    "date-and-time": "^2.4.1",
    "fastify": "^4.5.3",
    "ini": "^3.0.1",
    "lodash": "^4.17.21",
    "mongoose": "^6.5.4",
    "mongoose-geojson-schema": "^2.2.3",
    "mongoose-int32": "^0.6.0",
    "nanoid": "^4.0.0",
    "object-path": "^0.11.8",
    "sanitize-filename": "^1.6.3",
    "sshpk": "^1.17.0",
    "uuid": "^8.3.2",
    "winston": "^3.8.1",
    "winston-daily-rotate-file": "^4.7.1",
    "xstate": "^4.33.4"
  },
  "devDependencies": {
    "@babel/core": "^7.18.13",
    "@babel/eslint-parser": "^7.18.9",
    "@babel/preset-env": "^7.18.10",
    "axios-curlirize": "^2.0.0",
    "eslint": "^8.23.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-unused-imports": "^2.0.0",
    "nodemon": "^2.0.19",
    "prettier": "^2.7.1"
  }
}
